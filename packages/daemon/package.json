{
  "name": "crew-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "crew's long-running state-tracking daemon: Fastify HTTP server, SQLite state store, transcript watcher.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "crew-daemon": "./bin/crew-daemon"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fastify/awilix": "^8.2.0",
    "@fastify/static": "^9.1.3",
    "awilix": "^13.0.3",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.3",
    "crew-shared": "*",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "kysely": "^0.28.16",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.21.0"
  }
}
