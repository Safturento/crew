/.idea

# Dependencies
node_modules

# Build output
dist
build

# TypeScript incremental build cache
*.tsbuildinfo

# Vite
.vite
vite.config.*.timestamp-*

# Tests
coverage
.nyc_output

# Playwright
test-results
playwright-report
.playwright
.playwright-mcp/
/*.png

# Local env / overrides / secrets
*.local
.env
.env.*

# Logs
*.log
logs

# Caches
.cache
.eslintcache
.prettiercache

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor / temp
*.swp
*.swo
*~

# WSL / Windows alternate-data-stream metadata files (crash IntelliJ on click)
*:Zone.Identifier

# Local SQLite state for the daemon (per-machine, never useful in git)
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Crew's own runtime data dir (config + state).
# Pattern is `.crew/*`, not `.crew/`, so git still descends into the dir —
# a directory-level ignore cannot be undone by a negation below it.
.crew/*

# The figma-snapshot is a committed artifact — keep it tracked.
!.crew/figma-snapshot/
!.crew/figma-snapshot/**

# Per-repo agent sandbox config + secrets (gh-token, etc.)
# crew commits its own skills under .claude/skills/ — keep that tracked.
.claude/*
!.claude/skills/
