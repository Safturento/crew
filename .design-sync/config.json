{
  "projectId": "31c64e47-da59-4422-98e8-19545272a5b5",
  "shape": "package",
  "pkg": "crew-dashboard",
  "globalName": "CrewDS",
  "buildCmd": "npm run build --workspace crew-dashboard && node .design-sync/prepare-css.mjs",
  "tsconfig": "tsconfig.json",
  "provider": { "component": "DarkThemeRoot" },
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Modal": { "cardMode": "single", "viewport": "720x560" },
    "AlertModal": { "cardMode": "single", "viewport": "720x560" },
    "Dialog": { "cardMode": "single", "viewport": "720x560" },
    "AlertDialog": { "cardMode": "single", "viewport": "720x560" },
    "Popover": { "cardMode": "single", "viewport": "560x400" },
    "Drawer": { "cardMode": "single", "viewport": "1100x640" },
    "TopNav": { "cardMode": "column" },
    "BrandMark": { "cardMode": "column" },
    "Button": { "cardMode": "column" },
    "Checkbox": { "cardMode": "column" },
    "DrawerHeader": { "cardMode": "column" },
    "ModalSelectionRow": { "cardMode": "column" },
    "Separator": { "cardMode": "column" },
    "Switch": { "cardMode": "column" }
  },
  "cssEntry": "dist/assets/ds-entry.css",
  "componentSrcMap": {
    "Badge": "src/components/ui/badge.tsx",
    "Button": "src/components/ui/button.tsx",
    "Checkbox": "src/components/ui/checkbox.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "AlertDialog": "src/components/ui/alert-dialog.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/label.tsx",
    "MetaList": "src/components/ui/meta-list.tsx",
    "PillBase": "src/components/ui/pill-base.tsx",
    "Popover": "src/components/ui/popover.tsx",
    "Separator": "src/components/ui/separator.tsx",
    "StateIcon": "src/components/ui/state-icon.tsx",
    "Switch": "src/components/ui/switch.tsx",
    "Tag": "src/components/ui/tag.tsx",
    "Modal": "src/components/Modal.tsx",
    "AlertModal": "src/components/AlertModal.tsx",
    "ModalSelectionRow": "src/components/ModalSelectionRow.tsx",
    "FormField": "src/components/FormField.tsx",
    "Stepper": "src/components/Stepper.tsx",
    "Drawer": "src/components/Drawer.tsx",
    "DrawerHeader": "src/components/DrawerHeader.tsx",
    "TopNav": "src/components/TopNav.tsx",
    "BrandMark": "src/components/BrandMark.tsx"
  }
}
