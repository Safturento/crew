meta {
  name: POST /api/runner/launching
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/runner/launching
  body: json
}

body:json {
  {
    "key": "BRUNO-FAIL-1",
    "projectName": "bruno-smoke",
    "command": "run",
    "worktreePath": "/tmp/bruno-smoke-worktree-fail",
    "branch": "BRUNO-FAIL-1",
    "startedAt": "2026-06-17T12:00:00Z"
  }
}

vars:post-response {
  launchingRunId: res.body.runId
}

assert {
  res.status: eq 201
  res.body.runId: isNumber
}

tests {
  test("pre-registers a launching run before preflight", () => {
    expect(res.body.runId).to.be.a("number");
  });
}

docs {
  CREW-244: registers the run as `launching` *before* preflight so an init
  failure has a row to convert. Chains `launchingRunId` forward; the
  post-failed-start step converts this same row in place.
}
