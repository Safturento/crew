meta {
  name: POST /api/runner/commands (supervisor)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/runner/commands
  body: json
}

body:json {
  {
    "agentKey": null,
    "kind": "supervisor_restart",
    "payload": null
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.kind: eq supervisor_restart
  res.body.status: eq pending
}

tests {
  test("a queue-level supervisor command enqueues with a null agentKey", () => {
    expect(res.body.agentKey).to.equal(null);
    expect(res.body.payload).to.equal(null);
    expect(res.body.error).to.equal(null);
  });
}

docs {
  Enqueues a supervisor-level reverse-queue command (CREW-293). Unlike the
  per-process cancel/pause kinds, `supervisor_stop` / `supervisor_restart` carry
  a null agentKey — they target the supervisor process itself. The host worker
  drains them and exits (stop) or exits-and-respawns (restart) via the runner's
  self-respawn loop.
}
