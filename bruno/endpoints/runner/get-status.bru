meta {
  name: GET /api/runner/status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/runner/status
}

assert {
  res.status: eq 200
  res.body.online: isBoolean
}

tests {
  test("status is online after the preceding heartbeat", () => {
    // post-heartbeat.bru runs before this in the smoke order.
    expect(res.body.online).to.equal(true);
    expect(res.body.lastSeen).to.be.a("number");
  });
}

docs {
  Current runner online/offline + lastSeen. The dashboard seeds its
  SSE-driven runner health chip from this on mount.
}
