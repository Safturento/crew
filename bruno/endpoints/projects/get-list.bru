meta {
  name: GET /api/projects
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/projects
}

assert {
  res.status: eq 200
  res.body.projects: isArray
}

tests {
  test("each project carries the expanded shape", () => {
    for (const project of res.body.projects) {
      expect(project.name).to.be.a("string");
      expect(project.repoPath).to.be.a("string");
      expect(project.branch).to.be.a("string");
      expect(project.jiraKey).to.be.a("string");
      expect(project.activeCount).to.be.a("number");
    }
  });

  test("projects are alphabetized by name", () => {
    const names = res.body.projects.map((p) => p.name);
    const sorted = [...names].sort();
    expect(names).to.deep.equal(sorted);
  });
}
