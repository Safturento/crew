meta {
  name: GET /api/agents/:key
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/agents/{{agentKey}}
}

script:pre-request {
  // Fallback for standalone runs. In the smoke chain, post-register-run.bru
  // sets `agentKey` via `vars:post-response`; this only fires if the chain
  // has not already populated it.
  if (!bru.getVar("agentKey")) {
    bru.setVar("agentKey", "BRUNO-1");
  }
}

assert {
  res.status: eq 200
  res.body.key: eq BRUNO-1
  res.body.project: isString
  res.body.ticket_key: eq BRUNO-1
  res.body.worktree_path: isString
  res.body.runs: isArray
  res.body.tool_call_count: isNumber
  res.body.tokens_by_tool: isArray
}

tests {
  test("AgentDetail shape — top-level fields", () => {
    const allowedStates = ["initializing", "running", "pr_open", "error", "finished"];
    expect(allowedStates).to.include(res.body.state);
    expect(res.body.ticket_title === null || typeof res.body.ticket_title === "string").to.equal(true);
    expect(res.body.pr_url === null || typeof res.body.pr_url === "string").to.equal(true);
  });

  test("tokens breakdown has all five buckets as numbers", () => {
    const t = res.body.tokens;
    expect(t.total).to.be.a("number");
    expect(t.input).to.be.a("number");
    expect(t.output).to.be.a("number");
    expect(t.cache_read).to.be.a("number");
    expect(t.cache_creation).to.be.a("number");
  });

  test("at least one run is reported, with id (string), command, started_at, completed_at", () => {
    const allowedCommands = ["run", "fix-pr", "finish"];
    expect(res.body.runs.length).to.be.greaterThan(0);
    for (const r of res.body.runs) {
      expect(r.id).to.be.a("string");
      expect(allowedCommands).to.include(r.command);
      expect(r.started_at).to.be.a("string");
      expect(r.completed_at === null || typeof r.completed_at === "string").to.equal(true);
    }
  });

  test("each run carries the four Layer-1 metric columns (number or null)", () => {
    const metricKeys = [
      "doc_load_coverage_pct",
      "cleanliness_pass",
      "pr_claim_input_tokens",
      "parity_violations",
    ];
    for (const r of res.body.runs) {
      for (const k of metricKeys) {
        expect(r[k] === null || typeof r[k] === "number").to.equal(true);
      }
    }
  });

  test("app_url + jira_url are string or null (drawer redesign, CREW-178)", () => {
    expect(res.body.app_url === null || typeof res.body.app_url === "string").to.equal(true);
    expect(res.body.jira_url === null || typeof res.body.jira_url === "string").to.equal(true);
  });

  test("tokens_by_tool rows shape: { tool: string, tokens: number, percent: number }", () => {
    for (const row of res.body.tokens_by_tool) {
      expect(row.tool).to.be.a("string");
      expect(row.tokens).to.be.a("number");
      expect(row.tokens).to.be.at.least(0);
      expect(row.percent).to.be.a("number");
      expect(row.percent).to.be.within(0, 100);
    }
  });

  test("Assistant row (CREW-191) sorts first when present", () => {
    // BRUNO-1 has no JSONL transcript, so no Assistant row is expected on
    // this card — the positive case is asserted in get-by-key-with-transcript.bru
    // against CREW-102. This guards the contract: IF the synthetic "Assistant"
    // row is present, it must be at index 0.
    const assistantIdx = res.body.tokens_by_tool.findIndex((r) => r.tool === "Assistant");
    if (assistantIdx >= 0) {
      expect(assistantIdx).to.equal(0);
    }
  });
}

docs {
  Reference card. In the smoke chain, `agentKey` is set by
  `post-register-run.bru`'s `vars:post-response` block — this card just
  reads it. Standalone runs fall back to `BRUNO-1` via the pre-request
  script; pass `--env-var agentKey=<other>` on the CLI to probe other
  keys.
  404 when no run exists for the key — see get-by-key-not-found.bru.
}
