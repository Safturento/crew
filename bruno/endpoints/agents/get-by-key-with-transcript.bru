meta {
  name: GET /api/agents/:key (CREW-102 — Assistant row, CREW-191)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/agents/CREW-102
}

assert {
  res.status: eq 200
  res.body.key: eq CREW-102
  res.body.tokens_by_tool: isArray
}

tests {
  test("tokens_by_tool surfaces an Assistant row (CREW-191)", () => {
    const assistant = res.body.tokens_by_tool.find((r) => r.tool === "Assistant");
    expect(assistant, "expected an Assistant row in tokens_by_tool").to.exist;
    expect(assistant.tokens).to.be.a("number");
    expect(assistant.tokens).to.be.greaterThan(0);
  });

  test("Assistant row is the first entry in tokens_by_tool", () => {
    expect(res.body.tokens_by_tool[0].tool).to.equal("Assistant");
  });

  test("Assistant row's percent is within 0-100 and matches its share of the combined total", () => {
    const rows = res.body.tokens_by_tool;
    const total = rows.reduce((s, r) => s + r.tokens, 0);
    const assistant = rows[0];
    expect(assistant.percent).to.be.within(0, 100);
    const expected = total > 0 ? (assistant.tokens / total) * 100 : 0;
    // Allow ≤0.5pp drift for the daemon's rounding (Math.round(... * 10000)/100).
    expect(Math.abs(assistant.percent - expected)).to.be.below(0.5);
  });
}

docs {
  CREW-191 positive case. CREW-102 is the seeded composite-transcript
  fixture (packages/daemon/src/seeds/dev.ts) containing assistant text +
  thinking + tool_use events. The daemon re-parses the JSONL via
  TimelineService inside AgentsService.getByKey and prepends an
  "Assistant" row to tokens_by_tool summing usage.output_tokens across
  every assistant event.

  Per-tool shape is already covered by get-by-key.bru; this card adds
  the positive Assistant-row assertion that the smoke chain (BRUNO-1)
  can't make.
}
