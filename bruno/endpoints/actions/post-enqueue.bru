meta {
  name: POST /api/actions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/actions
  body: json
}

body:json {
  {
    "kind": "run",
    "ticketKey": "CREW-1",
    "project": "crew"
  }
}

vars:post-response {
  actionId: res.body.id
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.kind: eq run
  res.body.status: eq pending
}

tests {
  test("enqueue echoes the request envelope as a pending action", () => {
    expect(res.body.ticketKey).to.equal("CREW-1");
    expect(res.body.project).to.equal("crew");
    expect(res.body.payload).to.deep.equal({ kind: "run" });
    expect(res.body.error).to.equal(null);
  });
}

docs {
  Enqueues a dashboard-triggered `run` action against the seeded `crew`
  project and chains the new row's id forward as `actionId` for the
  get-pending / post-result steps. The target project must be registered
  (an unknown project 404s); the seeded worktree daemon ships `crew.toml`.
}
