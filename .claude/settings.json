{
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "allow": [
      "Bash(npm run test:run)",
      "Bash(npm run test:run *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run format:check)",
      "Bash(npm run format:check *)",
      "Bash(npm run lint:agents)",
      "Bash(npm run lint:agents *)",
      "mcp__atlassian__jira_get_issue",
      "mcp__atlassian__jira_get_transitions",
      "mcp__atlassian__jira_search",
      "mcp__claude_ai_Atlassian_Rovo__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian_Rovo__getTransitionsForJiraIssue",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_console_messages"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "npm run bruno:smoke*",
      "npm run test:e2e*",
      "docker compose*",
      "npx crew*"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/node",
        "~/.cache/claude-cli",
        "~/.cache/claude",
        "/tmp"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "ui.shadcn.com",
        "safturento.atlassian.net",
        "api.atlassian.com",
        "mcp.atlassian.com",
        "auth.atlassian.com",
        "api.anthropic.com",
        "statsig.anthropic.com",
        "claude.ai",
        "api.figma.com",
        "localhost",
        "127.0.0.1"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/packages/cli/scripts/hooks/visual-fidelity-pr-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/packages/cli/scripts/hooks/update-config-reminder.sh"
          }
        ]
      }
    ]
  }
}
